{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UU Filer",
  "version": "0.1.0",
  "identifier": "app.uufiler.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "UU Filer", "width": 1320, "height": 860, "minWidth": 960, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "shortDescription": "本地优先的文件批量管理工具" }
}
